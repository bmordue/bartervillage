# Copy for local development only. Never commit real deployment values.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./barter-village.sqlite
WORLD_ID=village
TICK_LOCK_PATH=./tick.lock
POLL_INTERVAL_MS=60000
NODE_ENV=development
BARTER_RP_ID=localhost
BARTER_ORIGIN=http://localhost:3000
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
BARTER_CREDENTIAL_KEY=
# Optional Discord OAuth login (M4.C02). Leave both unset to disable it.
BARTER_DISCORD_CLIENT_ID=
BARTER_DISCORD_CLIENT_SECRET=
BARTER_DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
# Optional GitHub OAuth login (M4.C03). Leave both unset to disable it.
BARTER_GITHUB_CLIENT_ID=
BARTER_GITHUB_CLIENT_SECRET=
BARTER_GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
